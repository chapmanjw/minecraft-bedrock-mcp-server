{
  "name": "minecraft-bedrock-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server that bridges MCP clients to a Minecraft Bedrock Dedicated Server.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "minecraft",
    "minecraft-bedrock",
    "bedrock-dedicated-server",
    "bds",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "John Chapman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chapmanjw/minecraft-bedrock-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/chapmanjw/minecraft-bedrock-mcp-server/issues"
  },
  "homepage": "https://github.com/chapmanjw/minecraft-bedrock-mcp-server#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
