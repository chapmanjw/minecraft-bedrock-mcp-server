# Bedrock Bridge MCP Server — environment configuration.
# Copy to `.env` and adjust. Required variables have no default.

# --- Required ---------------------------------------------------------------
# Bearer token presented by MCP clients on the /mcp surface.
BRIDGE_CLIENT_TOKEN=replace-with-a-long-random-secret
# Bearer token presented by the BDS behavior pack on the /bridge surface.
BRIDGE_AGENT_TOKEN=replace-with-a-different-long-random-secret
# Absolute path to the active BDS world folder.
BRIDGE_WORLD_PATH=/opt/bedrock-server/worlds/Bedrock level
# Absolute path to the behavior pack folder inside that world.
BRIDGE_BEHAVIOR_PACK_PATH=/opt/bedrock-server/worlds/Bedrock level/behavior_packs/bedrock-bridge

# --- Network ----------------------------------------------------------------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
# Set true only when running behind a reverse proxy that sets X-Forwarded-*.
BRIDGE_TRUST_PROXY=false

# --- TLS (set both variables, or neither) -----------------------------------
# BRIDGE_TLS_CERT=/etc/bedrock-bridge/tls/cert.pem
# BRIDGE_TLS_KEY=/etc/bedrock-bridge/tls/key.pem

# --- Tuning -----------------------------------------------------------------
BRIDGE_LOG_LEVEL=info
BRIDGE_POLL_TIMEOUT_MS=30000
BRIDGE_COMMAND_TIMEOUT_MS=15000
BRIDGE_RATE_LIMIT_RPM=60
BRIDGE_MAX_BODY_BYTES=16777216
BRIDGE_QUEUE_MAX=256

# --- CORS (comma-separated origins; unset disables CORS) --------------------
# BRIDGE_CORS_ORIGINS=https://studio.example.com,https://editor.example.com
